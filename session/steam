#!/bin/sh
# Steam in a wirbel session: on the NVIDIA, through PRIME render offload. Comes first in the PATH of
# the session, and its desktop entry points here. See docs/SESSION.md.
#
# Otherwise Steam's web view draws on the iGPU, where wirbel composes and Xwayland copies, and the
# frames of the compositor have to queue behind it: measured in `docs/PLAN.md`, "Stocken beim
# Scrollen". `/usr/bin/steam` in a terminal is the way around this.
export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only
exec /bedrock/bin/strat void /usr/bin/steam "$@"
